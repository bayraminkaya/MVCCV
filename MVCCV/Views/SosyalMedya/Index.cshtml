﻿@using MVCCV.Models.Entity
@model List<TblSosyalMedya>
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
@{string durumu = "";}
<br />
<!DOCTYPE html>
<html>
<body class="hold-transition sidebar-mini">
    <div class="wrapper">
        <!-- Navbar -->
        <!-- Main content -->
        <section class="content">
            <div class="container-fluid">
                <div class="row">
                    <div class="col-md-12">
                        <div class="card">
                            <div class="card-header">
                                <h3 class="card-title">Sosyal Medya Listem</h3>
                            </div>
                            <!-- /.card-header -->
                            <div class="card-body">
                                <table class="table table-bordered">
                                    <thead>
                                        <tr>
                                            <th style="width: 10px">#</th>

                                            <th>SOSYAL MEDYA</th>
                                            <th>DURUM</th>
                                            <th>SİL</th>
                                            <th>GÜNCELLE</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model)
                                        {
                                            if (item.Durum == true)
                                            {
                                                durumu = "Aktif";
                                            }
                                            else
                                            {
                                                durumu = "Pasif";
                                            }

                                            <tr>
                                                <td>@item.ID.</td>
                                                <td>@item.Ad</td>
                                                <td>@durumu</td>
                                                <td>
                                                    <a class="btn btn-danger btn-sm" href="/SosyalMedya/Sil/@item.ID">
                                                        <i class="fas fa-trash">
                                                        </i>
                                                        SİL
                                                    </a>
                                                </td>
                                                <td>
                                                    <a class="btn btn-info btn-sm" href="/SosyalMedya/SayfaGetir/@item.ID">
                                                        <i class="fas fa-pencil-alt">
                                                        </i>
                                                        GÜNCELLE
                                                    </a>
                                                </td>

                                            </tr>
                                        }
                                    </tbody>
                                </table>
                                <br />
                                @*<a href="/Yetenek/YeniYetenek/" class="btn btn-outline-success">YENİ SOSYAL MEDYA EKLE</a>*@
                                <button class="btn btn-success" data-toggle="modal" data-target="#Modal1">YENİ SOSYAL MEDYA EKLE</button>
                            </div>

                        </div>
                        <!-- /.card -->

                    </div>
                </div>
            </div><!-- /.container-fluid -->

        </section>
        <!-- /.content -->
        <div class="modal" id="Modal1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h2 class="modal-title">Sosyal Medya Ekleme Penceresi</h2>
                    </div>
                    <form method="post" action="/SosyalMedya/Ekle/">
                        <div class="modal-body">
                            <label>Sosyal Medya İsmi</label>
                            <input type="text" name="Ad" class="form-control" />
                            <br />
                            <label>Sosyal Medya Linki</label>
                            <input type="text" name="Link" class="form-control" />
                            <br />
                            <label>Sosyal Medya İcon</label>
                            <input type="text" name="icon" class="form-control" />
                            <br />
                            <button class="btn btn-dark">KAYDET</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

    </div>
</body>
</html>