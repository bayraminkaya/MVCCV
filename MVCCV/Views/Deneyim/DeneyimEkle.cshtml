
@{
    ViewBag.Title = "DeneyimEkle";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<br />
<h2>Yeni Deneyim EKleme Sayfası</h2>
<br />
<form method="post">
    
    <input type="text"name="Baslik" class="form-control" placeholder="Başlığı Yazınız"/>
    <br />
    <input type="text"name="AltBaslik" class="form-control" placeholder="Alt Başlık"/>
    <br />
    <input type="text"name="Tarih" class="form-control" placeholder="Açıklama"/>
    <br />
    
    <textarea rows="5" placeholder="Açıklamanızı Giriniz" name="Aciklama" class="form-control"></textarea>
    <br />
    <button class="btn btn-info">Kaydet</button>
</form>