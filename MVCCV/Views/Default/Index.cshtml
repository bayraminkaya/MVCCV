@using MVCCV.Models.Entity
@model  List<TblHakkimda>
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <meta name="description" content="" />
    <meta name="author" content="" />
    <title>Bayram İnkaya</title>
    <link rel="icon" type="image/x-icon" href="assets/img/favicon.ico" />
    <!-- Font Awesome icons (free version)-->
    <script src="https://use.fontawesome.com/releases/v5.15.1/js/all.js" crossorigin="anonymous"></script>
    <!-- Google fonts-->
    <link href="https://fonts.googleapis.com/css?family=Saira+Extra+Condensed:500,700" rel="stylesheet" type="text/css" />
    <link href="https://fonts.googleapis.com/css?family=Muli:400,400i,800,800i" rel="stylesheet" type="text/css" />
    <!-- Core theme CSS (includes Bootstrap)-->
    <link href="/startbootstrap-resume-gh-pages/css/styles.css" rel="stylesheet" />
</head>
<body id="page-top">
    <!-- Navigation-->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary fixed-top" id="sideNav">
        <a class="navbar-brand js-scroll-trigger" href="#page-top">
            <span class="d-block d-lg-none">Bayram İnkaya</span>
            @foreach (var item in Model)
            {
                <span class="d-none d-lg-block"><img class="img-fluid img-profile rounded-circle mx-auto mb-2" src="@item.Resim" alt="" /></span>
            }

        </a>
        <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation"><span class="navbar-toggler-icon"></span></button>
        <div class="collapse navbar-collapse" id="navbarSupportedContent">
            <ul class="navbar-nav">
                <li class="nav-item"><a class="nav-link js-scroll-trigger" href="#about">Hakkımda</a></li>
                <li class="nav-item"><a class="nav-link js-scroll-trigger" href="#experience">Deneyimlerim</a></li>
                <li class="nav-item"><a class="nav-link js-scroll-trigger" href="#education">Eğitim Hayatım</a></li>
                <li class="nav-item"><a class="nav-link js-scroll-trigger" href="#skills">Yeteneklerim</a></li>
                <li class="nav-item"><a class="nav-link js-scroll-trigger" href="#interests">Hobilerim</a></li>
                <li class="nav-item"><a class="nav-link js-scroll-trigger" href="#awards">Sertifikalarım</a></li>
                <li class="nav-item"><a class="nav-link js-scroll-trigger" href="#contact">İletişim</a></li>
            </ul>
        </div>
    </nav>
    <!-- Page Content-->
    <div class="container-fluid p-0">
        <!-- About-->
        @foreach (var x in Model)
        {
            <section class="resume-section" id="about">
                <div class="resume-section-content">
                    <h1 class="mb-0">
                        @x.Ad
                        <span class="text-primary">@x.Soyad</span>
                    </h1>
                    <div class="subheading mb-5">
                        @x.Adres · @x.Telefon 
                        <a href="mailto:@x.Mail">@x.Mail</a>
                    </div>
                    <p class="lead mb-5">@x.Aciklama</p>
                    @Html.Action("SosyalMedya")
                </div>
            </section>
        }

        <hr class="m-0" />

        <!-- Experience-->
        <section class="resume-section" id="experience">
            @Html.Action("Deneyim")
        </section>
        <hr class="m-0" />
        <!-- Education-->
        <section class="resume-section" id="education">
            @Html.Action("Egitimlerim")
        </section>
        <hr class="m-0" />
        <!-- Skills-->
        <section class="resume-section" id="skills">
            @Html.Action("Yeteneklerim")
        </section>
        <hr class="m-0" />
        <!-- Interests-->
        <section class="resume-section" id="interests">
            @Html.Action("Hobilerim")
        </section>
        <hr class="m-0" />
        <!-- Awards-->
        <section class="resume-section" id="awards">
            @Html.Action("Sertifikalar")
        </section>
        <!-- contact-->
        <section class="resume-section" id="contact">
            <div class="resume-section-content">
                <h2 class="mb-5">İletişim</h2>

                <!-- Geri Bildirim Mesajı -->
                <div id="resultMessage" class="alert d-none" role="alert"></div>

                <!-- Form Başlangıcı -->
                <form id="iletisimForm" class="p-4 rounded shadow-sm bg-light">

                    <div class="form-group mb-4">
                        <label for="AdSoyad">
                            <i class="fas fa-user mr-2 text-primary"></i> Ad Soyad
                        </label>
                        <input type="text" class="form-control" id="AdSoyad" name="AdSoyad" placeholder="Adınızı ve soyadınızı yazınız" required />
                    </div>

                    <div class="form-group mb-4">
                        <label for="Mail">
                            <i class="fas fa-envelope mr-2 text-primary"></i> E-Posta
                        </label>
                        <input type="email" class="form-control" id="Mail" name="Mail" placeholder="ornek@mail.com" required />
                    </div>

                    <div class="form-group mb-4">
                        <label for="Konu">
                            <i class="fas fa-tag mr-2 text-primary"></i> Konu
                        </label>
                        <input type="text" class="form-control" id="Konu" name="Konu" placeholder="Mesaj konusu" required />
                    </div>

                    <div class="form-group mb-4">
                        <label for="Mesaj">
                            <i class="fas fa-comment-alt mr-2 text-primary"></i> Mesaj
                        </label>
                        <textarea class="form-control" id="Mesaj" name="Mesaj" rows="5" placeholder="Mesajınızı buraya yazabilirsiniz..." required></textarea>
                    </div>

                    <div class="text-end">
                        <button type="submit" class="btn btn-primary px-4 py-2">
                            <i class="fas fa-paper-plane"></i> Gönder
                        </button>
                    </div>
                </form>
            </div>
        </section>

    </div>
    <!-- Bootstrap core JS-->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.5.3/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Third party plugin JS-->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-easing/1.4.1/jquery.easing.min.js"></script>
    <!-- Core theme JS-->
    <script src="/startbootstrap-resume-gh-pages/js/scripts.js"></script>
</body>
</html>
<script>
    $(document).ready(function () {
        $('#iletisimForm').submit(function (e) {
            e.preventDefault();

            $.ajax({
                type: 'POST',
                url: '/Default/Iletisim', // Burayı elle yazıyoruz çünkü Layout yok
                data: $(this).serialize(),
                success: function (response) {
                    if (response.success) {
                        $('#resultMessage')
                            .removeClass('d-none alert-danger')
                            .addClass('alert-success')
                            .text(response.message);
                        $('#iletisimForm')[0].reset();
                    } else {
                        $('#resultMessage')
                            .removeClass('d-none alert-success')
                            .addClass('alert-danger')
                            .text('Bir hata oluştu. Lütfen tekrar deneyin.');
                    }
                },
                error: function () {
                    $('#resultMessage')
                        .removeClass('d-none alert-success')
                        .addClass('alert-danger')
                        .text('Sunucu hatası oluştu.');
                }
            });
        });
    });
</script>

